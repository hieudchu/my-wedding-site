{
  "buildCommand": "cd app && npm run build",
  "outputDirectory": "app/dist",
  "installCommand": "cd app && npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/adult",
      "destination": "/api/share-adult"
    },
    {
      "source": "/adult/",
      "destination": "/api/share-adult"
    },
    {
      "source": "/thiep-moi",
      "destination": "/api/share-adult"
    },
    {
      "source": "/thiep-moi/",
      "destination": "/api/share-adult"
    },
    {
      "source": "/thiep-moi/:v",
      "destination": "/api/share-adult"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(png|jpg|jpeg|webp|svg|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "functions": {
    "api/share-adult.js": {
      "includeFiles": "app/dist/adult.html",
      "maxDuration": 10
    }
  }
}
